      "parameters": {
        "jsCode": "const data = $json;\n\nlet concernScore = 0;\n\nif (data.sugarLevel === 'alto') concernScore++;\nif (data.saltLevel === 'alto') concernScore++;\nif (data.fatLevel === 'alto') concernScore++;\n\nreturn {\n  json: {\n    ...data,\n    concernScore\n  }\n};"
      },
